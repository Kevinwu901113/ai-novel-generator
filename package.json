{
  "name": "ai-novel-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "中文优先、本地优先、BYOK 的桌面 AI 小说创作代理",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-novel/desktop dev",
    "build": "pnpm -r build",
    "package": "pnpm --filter @ai-novel/desktop package",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.30.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
