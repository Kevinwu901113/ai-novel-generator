{
  "name": "@ai-novel/writing-evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "离线、可复现、中文优先的文章质量评测实验基础设施（suite / 自动指标 / 盲评 / 人工评分聚合）",
