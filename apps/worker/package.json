{
  "name": "@ai-novel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && find dist -name '*.map' -delete && find dist -name '*.test.*' -delete"
  },
  "dependencies": {
    "@ai-novel/application": "workspace:*",
    "@ai-novel/contracts": "workspace:*",
    "@ai-novel/database": "workspace:*",
    "@ai-novel/domain": "workspace:*",
    "@ai-novel/import-export": "workspace:*",
    "@ai-novel/model-gateway": "workspace:*",
    "@ai-novel/research-engine": "workspace:*",
    "@ai-novel/secret-store": "workspace:*",
    "@ai-novel/task-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
