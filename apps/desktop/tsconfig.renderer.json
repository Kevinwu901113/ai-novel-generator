{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./dist/renderer",
    "rootDir": "./src/renderer",
    "strict": true
  },
  "include": ["src/renderer"],
  "exclude": ["src/renderer/**/*.test.ts", "src/renderer/**/*.test.tsx"]
}
